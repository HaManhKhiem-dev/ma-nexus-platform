{
  "firestore": {
    "database": "ai-studio-b7242412-8805-4852-ba4e-b7cf14838f59",
    "location": "asia-southeast1",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
